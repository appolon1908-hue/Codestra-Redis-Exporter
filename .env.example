# Pin a reviewed oliver006/redis_exporter image by digest. Tags and latest are forbidden.
REDIS_EXPORTER_IMAGE=

# One exporter instance owns exactly one private Redis target.
REDIS_ADDR=redis://redis:6379
REDIS_EXPORTER_USER=codestra_exporter

# The external secret must be a JSON object with exactly one entry keyed by the
# normalized target URI including the ACL user, for example:
# {"redis://codestra_exporter@redis:6379":"INJECT_FROM_OPENBAO"}
REDIS_EXPORTER_PASSWORD_MAP_SECRET=codestra-redis-exporter-password-map
CODESTRA_OBSERVABILITY_NETWORK=codestra-observability
CODESTRA_CACHE_NETWORK=codestra-cache
